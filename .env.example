# Copie este arquivo para .env.local e preencha. NUNCA coloque valores reais aqui.
# URL pública do site (sem barra no final). Em testes locais: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Supabase (Project Settings > API). Estas duas são PÚBLICAS por desenho; a segurança vem das regras (RLS) do banco.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave SECRETA do Supabase (Project Settings > API > service_role). SÓ no servidor: nunca use NEXT_PUBLIC_ nela
# e nunca coloque em arquivos do repositório. Em testes locais vai no .env.local; na Vercel, em Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (Seus negócios > Configurações > Credenciais). Só no servidor, nunca com NEXT_PUBLIC_.
# Teste: credenciais de teste (começam com TEST-). Produção: troque pelas de produção.
MERCADOPAGO_ACCESS_TOKEN=
# Chave secreta do webhook (Suas integrações > Webhooks). Endereço do webhook: <NEXT_PUBLIC_SITE_URL>/api/mercadopago/webhook
MERCADOPAGO_WEBHOOK_SECRET=
